# Copy this file to .env and fill in real values on your own PC.
# .env is gitignored and blocked from Claude's file tools. Never commit it.

# Client ID from https://developer.spotify.com/dashboard
# This app uses the PKCE flow, so there is NO client secret. Do not create one.
SPOTIFY_CLIENT_ID=your-client-id-here

# Must exactly match a Redirect URI saved in your Spotify app settings.
# Loopback IP only. The word "localhost" is not allowed by Spotify.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
