{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(!.env.example)",
      "Edit(./secrets/**)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Select-String *.env*)",
      "PowerShell(Get-Content *secrets*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh repo create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh repo edit *)",
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(gh repo create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh repo edit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--quiet",
              "--no-sync",
              "--project",
              "${CLAUDE_PROJECT_DIR}",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
